<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ShizukuGameBooster" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorPrimaryDark">@color/bg_dark</item>
        <item name="colorAccent">@color/accent_rose</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <!-- Use our custom drawables as-is: stop MaterialButton from
             tinting every android:background with colorPrimary -->
        <item name="materialButtonStyle">@style/Widget.AuroraButton</item>
    </style>

    <style name="Widget.AuroraButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@null</item>
    </style>
</resources>

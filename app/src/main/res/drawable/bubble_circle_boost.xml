<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#306EE7B7" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="@color/accent_violet"
                android:endColor="@color/accent_indigo"
                android:type="linear" />
            <stroke android:width="1.5dp" android:color="@color/accent_mint" />
        </shape>
    </item>
</layer-list>

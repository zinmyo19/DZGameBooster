<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#309D8CFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/accent_violet"
                android:endColor="@color/accent_indigo"
                android:type="linear" />
            <stroke android:width="1dp" android:color="@color/accent_primary" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</layer-list>

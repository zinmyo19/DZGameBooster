<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- dark core -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#0C1024" />
        </shape>
    </item>
    <!-- mint gaming ring -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#0C1024" />
            <stroke android:width="2dp" android:color="@color/accent_mint" />
        </shape>
    </item>
    <!-- center power dot -->
    <item android:left="9dp" android:top="9dp" android:right="9dp" android:bottom="9dp">
        <shape android:shape="oval">
            <solid android:color="@color/accent_mint" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cyber_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="◢ GAME DETECTOR ◣"
        android:textColor="@color/accent_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvGamesHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="// SCANNING..."
        android:textColor="@color/text_dim"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="10dp" />

    <ListView
        android:id="@+id/lvGames"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/accent_primary"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/tvGamesEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="No games from the known list are installed.\nYou can still type a package name manually in Settings."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:layout_marginTop="24dp" />

</LinearLayout>
